# CoinGecko API (optional - falls back to mock data)
# DEV ONLY: VITE_* values are public in the built bundle. In production leave this
# unset and put the key on the server instead (`supabase secrets set COINGECKO_API_KEY=...`,
# see README "CoinGecko proxy").
VITE_COINGECKO_API_KEY=your_coingecko_api_key_here

# CoinGecko proxy (optional). By default, when VITE_SUPABASE_URL/ANON_KEY below are set,
# CoinGecko calls go through the `coingecko-proxy` Edge Function. Override with any
# CoinGecko-shaped URL (e.g. a Cloudflare Worker), or set `direct` to bypass the proxy.
# VITE_COINGECKO_PROXY_URL=https://your-worker.example.workers.dev

# MetalPrice API (optional - falls back to mock data)
VITE_METALPRICE_API_KEY=your_metalprice_api_key_here

# Supabase Configuration (optional - for backend storage of API keys)
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
